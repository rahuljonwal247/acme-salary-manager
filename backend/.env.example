DATABASE_URL="postgresql://acme:acme@localhost:5434/salaries?schema=public"
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"
# >= 32 chars; required in production (e.g. openssl rand -hex 32)
JWT_SECRET="dev-only-secret-change-me-in-production-0123456789"
# Optional: enables the Claude-powered assistant (otherwise the offline rules engine is used)
ANTHROPIC_API_KEY=
